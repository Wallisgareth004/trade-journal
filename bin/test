#!/usr/bin/env bash
# The full suite. Every test runs on made-up data in temp folders.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$here"
# Machine-only test settings (git-ignored), e.g. the path to an outside stats script.
if [ -f "$here/tests/local.env" ]; then set -a; . "$here/tests/local.env"; set +a; fi
cd "$here"
exec uv run --quiet --no-project --python 3.14 --with-requirements requirements-dev.txt python -m pytest -p no:cacheprovider -q "$@"
